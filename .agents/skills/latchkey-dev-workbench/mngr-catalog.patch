From 5812b7396f1d066942a7da6d57da86e557b076f2 Mon Sep 17 00:00:00 2001
From: workspace-2
 <agent-b76099b650614d72afcb34bd39d11167@host-e640559f45704698b2e2e7bb203118d1>
Date: Thu, 30 Jul 2026 23:02:07 -0700
Subject: [PATCH 2/2] mngr_latchkey: add ngrok's Detent scope schema via
 additional_services

Adds the ngrok-api scope schema (matching domain api.ngrok.com) to
additional_services.json. The gateway materializes this into
minds_shared_schemas.json at spawn so Detent can resolve the ngrok-api scope at
grant/enforcement time.

Without this, granting the ngrok-api scope fails every permission check
('references unknown schema #/$defs/ngrok-api') and bricks the agent's whole
permission evaluation. Pairs with the catalog entry and latchkey connector
(imbue-ai/latchkey#113).
---
 .../mngr_latchkey/additional_services.json    | 28 ++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/libs/mngr_latchkey/imbue/mngr_latchkey/additional_services.json b/libs/mngr_latchkey/imbue/mngr_latchkey/additional_services.json
index 335f974..21ed6ab 100644
--- a/libs/mngr_latchkey/imbue/mngr_latchkey/additional_services.json
+++ b/libs/mngr_latchkey/imbue/mngr_latchkey/additional_services.json
@@ -10,7 +10,9 @@
             "const": "claude.ai"
           }
         },
-        "required": ["domain"]
+        "required": [
+          "domain"
+        ]
       }
     },
     "permissions": [
@@ -20,5 +22,29 @@
         "schema": {}
       }
     ]
+  },
+  "ngrok": {
+    "display_name": "ngrok",
+    "base_api_url": "https://api.ngrok.com/",
+    "scope": {
+      "name": "ngrok-api",
+      "schema": {
+        "properties": {
+          "domain": {
+            "const": "api.ngrok.com"
+          }
+        },
+        "required": [
+          "domain"
+        ]
+      }
+    },
+    "permissions": [
+      {
+        "name": "everything",
+        "description": "Full access to the ngrok API.",
+        "schema": {}
+      }
+    ]
   }
 }
-- 
2.47.3

