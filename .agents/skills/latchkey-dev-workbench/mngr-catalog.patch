 <agent-b76099b650614d72afcb34bd39d11167@host-e640559f45704698b2e2e7bb203118d1>
Date: Thu, 30 Jul 2026 22:21:22 -0700
Subject: [PATCH 1/2] mngr_latchkey: add ngrok to the service permission
 catalog

Exposes the ngrok-api scope in services.json (with curated display name and
ordering) so agents can request access to the ngrok REST API, pairing with the
ngrok connector in latchkey (imbue-ai/latchkey#113).

The catalog is generated from Detent's built-in schemas; the durable change is a
Detent ngrok-api scope schema + regeneration. This commit reflects that output.
---
 libs/mngr_latchkey/changelog/add-ngrok-service-catalog.md | 3 +++
 .../imbue/mngr_latchkey/extensions/services.json          | 8 ++++++++
 libs/mngr_latchkey/scripts/generate_services_json.py      | 2 ++
 3 files changed, 13 insertions(+)
 create mode 100644 libs/mngr_latchkey/changelog/add-ngrok-service-catalog.md

diff --git a/libs/mngr_latchkey/changelog/add-ngrok-service-catalog.md b/libs/mngr_latchkey/changelog/add-ngrok-service-catalog.md
new file mode 100644
index 0000000..a216ed4
--- /dev/null
+++ b/libs/mngr_latchkey/changelog/add-ngrok-service-catalog.md
@@ -0,0 +1,3 @@
+Added: `ngrok` to the latchkey service permission catalog (`services.json`), exposing the `ngrok-api` scope so agents can request access to the ngrok REST API. Includes the curated display name and catalog ordering in `generate_services_json.py`.
+
+Note: this pairs with the ngrok service connector in latchkey (imbue-ai/latchkey#113). The catalog is normally regenerated from Detent's built-in schemas, so the durable change is a Detent `ngrok-api` scope schema plus a regeneration; the `services.json` edit here reflects that regenerated output.
diff --git a/libs/mngr_latchkey/imbue/mngr_latchkey/extensions/services.json b/libs/mngr_latchkey/imbue/mngr_latchkey/extensions/services.json
index 9b82558..8c9cf5f 100644
--- a/libs/mngr_latchkey/imbue/mngr_latchkey/extensions/services.json
+++ b/libs/mngr_latchkey/imbue/mngr_latchkey/extensions/services.json
@@ -1823,5 +1823,13 @@
         }
       ]
     }
+  ],
+  "ngrok": [
+    {
+      "scope": "ngrok-api",
+      "display_name": "ngrok",
+      "description": "All requests to the ngrok API.",
+      "permissions": []
+    }
   ]
 }
diff --git a/libs/mngr_latchkey/scripts/generate_services_json.py b/libs/mngr_latchkey/scripts/generate_services_json.py
index acfeb65..fd09da5 100644
--- a/libs/mngr_latchkey/scripts/generate_services_json.py
+++ b/libs/mngr_latchkey/scripts/generate_services_json.py
@@ -84,6 +84,7 @@ _DISPLAY_NAME_BY_SCOPE: Final[Mapping[str, str]] = {
     "gitlab-git": "GitLab (git)",
     "dropbox-api": "Dropbox",
     "linear-api": "Linear",
+    "ngrok-api": "ngrok",
     "notion-api": "Notion",
     "notion-mcp-api": "Notion (MCP)",
     "mailchimp-api": "Mailchimp",
@@ -116,6 +117,7 @@ _SERVICE_ORDER: Final[Sequence[str]] = (
     "gitlab",
     "dropbox",
     "linear",
+    "ngrok",
     "notion",
     "notion-mcp",
     "mailchimp",
